# Copy this file to .env and fill in your real values. .env is gitignored - never commit
# real API keys. Used by lucid.py (local Flask dev server) and local_negotiation_test.py
# (terminal test harness for prompts.yaml).

# Required - your OpenAI API key.
OPENAI_API_KEY=sk-...

# Optional - comma-separated list of origins allowed to call /lucid via CORS.
# Leave unset (or "*") to allow all origins, which lucid.py already defaults to.
# ALLOWED_ORIGINS=https://yourinstitution.qualtrics.com

# --- local_negotiation_test.py only (both optional) ---
# Model to chat with locally. Defaults to gpt-4o if unset (matches lucid.py's default).
# LUCID_TEST_MODEL=gpt-4o

# Sampling temperature for the local test session. Defaults to 1.0 if unset.
# LUCID_TEST_TEMPERATURE=1.0
